{
    "name": "sierratecnologia/payment-php",
    "type": "library",
    "keywords": [
        "SierraTecnologia",
        "sitec",
        "api",
        "sdk",
        "payment processing",
        "api"
    ],
    "homepage": "https://sierratecnologia.com.br",
    "license": "MIT",
    "authors": [
        {
            "name": "Sierra Tecnologia",
            "email": "contato@sierratecnologia.com.br",
            "homepage": "https://sierratecnologia.com.br",
            "role": "Organizer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "php-coveralls/php-coveralls": "^2.9",
        "squizlabs/php_codesniffer": "^3.11",
        "symfony/process": "^7.2",
        "phpro/grumphp": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "SierraTecnologia\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/cashier"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp": true
        }
    },
    "version": "2.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true
}
