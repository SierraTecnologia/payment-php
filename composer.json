{
    "name": "sierratecnologia/payment-php",
    "type": "library",
    "keywords": [
        "SierraTecnologia",
        "sitec",
        "api",
        "sdk",
        "payment processing",
        "api"
    ],
    "homepage": "https://sierratecnologia.com.br",
    "license": "MIT",
    "authors": [
        {
            "name": "Sierra Tecnologia",
            "email": "contato@sierratecnologia.com.br",
            "homepage": "https://sierratecnologia.com.br",
            "role": "Organizer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0",
        "php-coveralls/php-coveralls": "^2.7",
        "squizlabs/php_codesniffer": "^3.10",
        "symfony/process": "^5.4 || ^6.4 || ^7.0",
        "phpro/grumphp": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "SierraTecnologia\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/cashier"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp": true
        }
    }
}
